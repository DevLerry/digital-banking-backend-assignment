# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Database (MongoDB Atlas) ----
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/digital_banking?retryWrites=true&w=majority

# ---- Our own customer-facing JWT (Layer 2) ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# ---- NibssByPhoenix credentials (Layer 1) ----
# Arrive by email after POST /api/fintech/onboard
NIBSS_BASE_URL=https://nibssbyphoenix.onrender.com
NIBSS_API_KEY=
NIBSS_API_SECRET=

# Optional: public DNS resolvers if your ISP cannot resolve mongodb+srv SRV records
DNS_SERVERS=8.8.8.8,1.1.1.1
